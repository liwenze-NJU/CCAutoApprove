<UserControl x:Class="CCAutoApprove.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource AuditSettingsTitle}" FontSize="24" FontWeight="SemiBold" />
            <RadioButton Content="{DynamicResource AuditDisabled}" IsChecked="{Binding IsAuditDisabled, Mode=OneWay}"
                         Command="{Binding SelectDisabledCommand}" Margin="0,14,0,6" />
            <RadioButton Content="{DynamicResource AuditPrivacySafe}" IsChecked="{Binding IsPrivacySafe, Mode=OneWay}"
                         Command="{Binding SelectPrivacySafeCommand}" Margin="0,0,0,6" />
            <RadioButton Content="{DynamicResource AuditDetailed}" IsChecked="{Binding IsDetailed, Mode=OneWay}"
                         Command="{Binding SelectDetailedCommand}" Margin="0,0,0,6" />
            <Border Background="#FFFFE8B2" Padding="12" Margin="0,6,0,20"
                    Visibility="{Binding ShowDetailedWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{DynamicResource DetailedWarning}" TextWrapping="Wrap" />
            </Border>

            <CheckBox Content="{DynamicResource StartupLabel}" IsChecked="{Binding StartupEnabled, Mode=OneWay}" IsThreeState="True"
                      IsEnabled="{Binding CanChangeStartup}" Command="{Binding ChangeStartupEnabledCommand}"
                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Margin="0,4,0,20" />

            <TextBlock Text="{DynamicResource HookActionsTitle}" FontSize="20" FontWeight="SemiBold" />
            <WrapPanel Margin="0,12,0,0">
                <Button Content="{DynamicResource InstallHook}" Command="{Binding InstallHookCommand}" MinWidth="110" Margin="0,0,10,8" Padding="12,6" />
                <Button Content="{DynamicResource RunDoctor}" Command="{Binding DoctorCommand}" MinWidth="110" Margin="0,0,10,8" Padding="12,6" />
                <Button Content="{DynamicResource UninstallHook}" Command="{Binding UninstallHookCommand}" MinWidth="110" Margin="0,0,0,8" Padding="12,6" />
            </WrapPanel>
            <TextBlock Text="{Binding OperationMessage}" Foreground="Firebrick" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
