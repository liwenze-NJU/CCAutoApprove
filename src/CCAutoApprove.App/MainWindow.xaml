<Window x:Class="CCAutoApprove.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}"
        Height="640" Width="980" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#FFF3F4F6" BorderBrush="#FFD8DCE2" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource AppName}" FontSize="20"
                           FontWeight="SemiBold" Margin="18,22,12,18" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}"
                         DisplayMemberPath="Title"
                         BorderThickness="0" Background="Transparent"
                         Padding="8" FontSize="16" />
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1"
                        Content="{Binding SelectedPage.Content}" />
    </Grid>
</Window>
